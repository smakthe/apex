# ==========================================
# APEX Polyglot Engine - .gitignore
# ==========================================

# ------------------------------------------
# General / OS / IDEs
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.log

# ------------------------------------------
# APEX Specific Data & Scratch
# ------------------------------------------
data/
*.csv
*.parquet
*.ibd
scratch/

# ------------------------------------------
# Rust (core/jit, core/storage)
# ------------------------------------------
target/
**/*.rs.bk
Cargo.lock # Optional: Remove if you want reproducible binary builds

# ------------------------------------------
# Go (cmd/apex, core/raft)
# ------------------------------------------
# Compiled binaries
cmd/apex/apex
*.exe
*.exe~
*.test
*.prof
# Avoid committing vendor folder if using standard modules
vendor/

# ------------------------------------------
# C / C++ / ASM / CUDA (core/allocator, core/kernels)
# ------------------------------------------
# Object files and shared libraries
*.o
*.so
*.dylib
*.a
*.dll
*.out
*.app
*.dSYM/
# CUDA compiled binaries
*.ptx
*.cubin


# ------------------------------------------
# TypeScript / Node.js (core/runtime)
# ------------------------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# SystemVerilog / FPGA (core/fpga)
# ------------------------------------------
# Vivado / Simulation artifacts
*.jou
*.pb
*.wdb
xsim.dir/
.Xil/
